<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textview_beingIsraeli"
        android:layout_width="179dp"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:text="@string/being_israeli"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView_israelFlag"
        android:layout_width="166dp"
        android:layout_height="122dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/textview_beingIsraeli"
        app:layout_constraintStart_toStartOf="@+id/textview_beingIsraeli"
        app:layout_constraintTop_toBottomOf="@+id/textview_beingIsraeli"
        app:srcCompat="@drawable/israel_flag" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16dp" />

    <ImageView
        android:id="@+id/imageView_falafel"
        android:layout_width="102dp"
        android:layout_height="151dp"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageView_israeliView"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/falafel" />

    <ImageView
        android:id="@+id/imageView_israeliView"
        android:layout_width="115dp"
        android:layout_height="162dp"
        app:layout_constraintEnd_toStartOf="@+id/imageView_hafia"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/imageView_falafel"
        app:layout_constraintTop_toTopOf="@+id/imageView_falafel"
        app:srcCompat="@drawable/israeli_view" />

    <ImageView
        android:id="@+id/imageView_hafia"
        android:layout_width="131dp"
        android:layout_height="166dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/imageView_israeliView"
        app:layout_constraintTop_toTopOf="@+id/imageView_falafel"
        app:srcCompat="@drawable/haifa" />

    <TextView
        android:id="@+id/textView_explanation"
        android:layout_width="0dp"
        android:layout_height="227dp"
        android:layout_marginTop="28dp"
        android:text="@string/explanation"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineVertical2"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/guidelineVertical1"
        app:layout_constraintTop_toBottomOf="@+id/imageView_israelFlag" />
</androidx.constraintlayout.widget.ConstraintLayout>
